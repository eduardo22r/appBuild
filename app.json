{
  "expo": {
    "name": "Language Learning App",
    "slug": "language-learning-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "languagelearningapp",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#4A90E2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.languagelearning.app"
    },
    "android": {
      "package": "com.languagelearning.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
